# ==========================================
# CONFIGURAÇÕES ÉTER TRAVEL INSTAGRAM ENGINE
# ==========================================

# 1. TELEGRAM BOT
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# 2. GOOGLE GEMINI AI
GEMINI_API_KEY=sua_gemini_api_key_aqui

# 3. UNSPLASH API
UNSPLASH_ACCESS_KEY=sua_unsplash_access_key_aqui

# 4. SUPABASE STORAGE (Para hospedar imagens temporariamente)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_supabase_key_aqui
SUPABASE_BUCKET=eter-instagram-public

# 5. META INSTAGRAM GRAPH API
INSTAGRAM_BUSINESS_ACCOUNT_ID=seu_instagram_account_id_aqui
META_ACCESS_TOKEN=seu_meta_long_lived_token_aqui

# 6. CONFIGURAÇÕES N8N
N8N_PORT=5678
N8N_ENCRYPTION_KEY=sua_chave_secreta_n8n_aqui
